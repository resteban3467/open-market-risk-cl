# =============================================================================
# API credentials — Open Market Risk (CL)
# Copy this file and fill in your own values:
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# =============================================================================

# Banco Central de Chile — BDE / Siete API
# Token válido por un año: https://si3.bcentral.cl/  (Mi cuenta -> Apikey Token)
# Usado por: bcch_adapter (BCP, BCU, TPM, UF, USD/CLP)
BCCH_API_TOKEN=your_bcch_api_token

# FRED — Federal Reserve Economic Data
# Clave gratuita: https://fredaccount.stlouisfed.org/apikeys
# Usado por: fred_adapter (SOFR, DGS2, DGS5, DGS10)
FRED_API_KEY=your_fred_api_key

# Alpaca — Paper Trading / market data
# Claves: https://app.alpaca.markets/paper/dashboard/overview
# Usado por: alpaca_adapter (barras diarias OHLCV)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# -----------------------------------------------------------------------------
# Nota: la suite de tests usa fixtures JSON estáticos y no requiere credenciales.
# -----------------------------------------------------------------------------
